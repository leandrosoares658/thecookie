# Netlify: um endereço por linha, na ordem. Arquivos que existem (imagens,
# JS, sitemap) são servidos antes destas regras.

# endereços antigos: redireciona de vez (301), para o Google trocar o link
/produtos             https://pedido.anota.ai/loja/the-cookie-co  301
/produtos/*           https://pedido.anota.ai/loja/the-cookie-co  301
/carrinho             https://pedido.anota.ai/loja/the-cookie-co  301
/delivery             https://pedido.anota.ai/loja/the-cookie-co  301
/servicos             /                                           301
/lojas                /                                           301

# páginas do site (o React monta a página no navegador). A Home usa o
# index.html, que já avisa do banner; as outras, o app.html, gerado no build.
/                     /index.html  200
/sobre                /app.html    200
/kits                 /app.html    200
/faca-em-casa         /app.html    200
/revenda              /app.html    200

# qualquer outro endereço: mostra a página "não encontrada" com status 404,
# para o Google não indexar endereço que não existe
/*                    /app.html    404
